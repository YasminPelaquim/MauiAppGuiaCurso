<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppGuiaCurso.Materias.Fundamentos"
             Title="Fundamentos">

    <VerticalStackLayout>
        <ScrollView>
            <Grid ColumnDefinitions="*" RowDefinitions="*, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *" Margin="10" RowSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="Fundamentos da Informática" HorizontalOptions="Center" FontSize="Header"/>

                <Label Grid.Row="2" Grid.Column="0" Text="Atribuições: Operar sistemas computacionais" HorizontalOptions="Center" FontSize="30"/>

                <Label Grid.Row="5" Grid.Column="0" Text="Habilidades: " FontSize="25" />
                <Label Grid.Row="6" Grid.Column="0" Text=" - Distinguir arquiteturas de sistemas de hardware e software" FontSize="20" />
                <Label Grid.Row="7" Grid.Column="0" Text=" - Executar comandos em interface de linha de comando" FontSize="20" />
                <Label Grid.Row="8" Grid.Column="0" Text=" - Utilizar sistemas computacionais" FontSize="20" />

                <Label Grid.Row="10" Grid.Column="0" Text="Bases Tecnológicas: " FontSize="25" />
                <Label Grid.Row="11" Grid.Column="0" Text=" - Conceitos básicos de tecnologia da informação," FontSize="20" />
                <Label Grid.Row="12" Grid.Column="0" Text=" - Fundamentos de sistemas operacionais," FontSize="20" />
                <Label Grid.Row="13" Grid.Column="0" Text=" - Laboratório em sistemas operacionais." FontSize="20" />
            </Grid>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>