<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppGuiaCurso.Materias.Analise"
             Title="Analise">

    <VerticalStackLayout>
        <ScrollView>
            <Grid ColumnDefinitions="*" RowDefinitions="*, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *" Margin="10" RowSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="Análise e projeto de sistemas" HorizontalOptions="Center" FontSize="Header"/>

                <Label Grid.Row="2" Grid.Column="0" Text="Atribuições: Elaborar projetos de sistema de  informação" HorizontalOptions="Center" FontSize="30"/>

                <Label Grid.Row="5" Grid.Column="0" Text="Habilidades: " FontSize="25" />
                <Label Grid.Row="6" Grid.Column="0" Text=" - Coletar requisitos de usuários e sistemas." FontSize="20" />
                <Label Grid.Row="7" Grid.Column="0" Text=" - Utilizar métodos de abordagem, coleta de dados e procedimentos de pesquisa." FontSize="20" />
                <Label Grid.Row="8" Grid.Column="0" Text=" - Aplicar modelo Cascata no desenvolvimento de sistemas." FontSize="20" />
                <Label Grid.Row="9" Grid.Column="0" Text=" - Aplicar modelos Ágeis a projetos de software." FontSize="20" />

                <Label Grid.Row="11" Grid.Column="0" Text="Bases Tecnológicas: " FontSize="25" />
                <Label Grid.Row="12" Grid.Column="0" Text=" - Ciclo de vida de um sistema" FontSize="20" />
                <Label Grid.Row="13" Grid.Column="0" Text="     * Estudo de viabilidade;" FontSize="20" />
                <Label Grid.Row="14" Grid.Column="0" Text="     * Especificação de requisitos;" FontSize="20" />
                <Label Grid.Row="15" Grid.Column="0" Text="     * Concepções do modelo Cascata;" FontSize="20" />
                <Label Grid.Row="16" Grid.Column="0" Text="     *Concepções dos modelos Ágeis." FontSize="20" />
            </Grid>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>