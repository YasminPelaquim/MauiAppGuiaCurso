<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppGuiaCurso.Materias.Programacaoweb2"
             Title="Programacaoweb2">

    <VerticalStackLayout>
        <ScrollView>
            <Grid ColumnDefinitions="*" RowDefinitions="*, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *" Margin="10" RowSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="Programação Web 2" HorizontalOptions="Center" FontSize="Header"/>

                <Label Grid.Row="2" Grid.Column="0" Text="Atribuições: Elaboração sistemas de informação para Web" HorizontalOptions="Center" FontSize="30"/>

                <Label Grid.Row="5" Grid.Column="0" Text="Habilidades: " FontSize="25" />
                <Label Grid.Row="6" Grid.Column="0" Text=" - Codificar software em linguagem para Web." FontSize="20" />
                <Label Grid.Row="7" Grid.Column="0" Text=" - Utilizar banco de dados relacionais para persistência dos dados." FontSize="20" />
                <Label Grid.Row="8" Grid.Column="0" Text=" - Utilizar interface baseada em navegador para interação com usuário." FontSize="20" />

                <Label Grid.Row="10" Grid.Column="0" Text="Bases Tecnológicas: " FontSize="25" />
                <Label Grid.Row="11" Grid.Column="0" Text=" - Introdução a scripts lado servidor," FontSize="20" />
                <Label Grid.Row="12" Grid.Column="0" Text=" - Variáveis e tipos de dados," FontSize="20" />
                <Label Grid.Row="13" Grid.Column="0" Text=" - Comunicação entre navegador e aplicação," FontSize="20" />
                <Label Grid.Row="14" Grid.Column="0" Text=" - Persistência em banco de dados," FontSize="20" />
                <Label Grid.Row="15" Grid.Column="0" Text=" - Modulação e organização dos programas." FontSize="20" />
            </Grid>
        </ScrollView>
    </VerticalStackLayout>

</ContentPage>