<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppGuiaCurso.Materias.Designdigital"
             Title="Designdigital">

    <VerticalStackLayout>
        <ScrollView>
            <Grid ColumnDefinitions="*" RowDefinitions="*, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *" Margin="10" RowSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="Design Digital" HorizontalOptions="Center" FontSize="Header"/>

                <Label Grid.Row="2" Grid.Column="0" Text="Atribuições: Desenvolver elementos gráficos para aplicativos e sites" HorizontalOptions="Center" FontSize="30"/>

                <Label Grid.Row="5" Grid.Column="0" Text="Habilidade: " FontSize="25" />
                <Label Grid.Row="6" Grid.Column="0" Text=" - Manipular ou construir elementos visuais para aplicativos e sites." FontSize="20" />
                
                <Label Grid.Row="8" Grid.Column="0" Text="Bases Tecnológicas: " FontSize="25" />
                <Label Grid.Row="9" Grid.Column="0" Text=" - Teoria das cores," FontSize="20" />
                <Label Grid.Row="10" Grid.Column="0" Text=" - Composição," FontSize="20" />
                <Label Grid.Row="11" Grid.Column="0" Text=" - Tipografia," FontSize="20" />
                <Label Grid.Row="12" Grid.Column="0" Text=" - Definição de formatos, resolução e tamanhos de imagens" FontSize="20" />
                <Label Grid.Row="13" Grid.Column="0" Text=" - Direitos autorais e direitos de uso de elementos visuais," FontSize="20" />
                <Label Grid.Row="14" Grid.Column="0" Text=" - Planejamento visual e leiaute," FontSize="20" />
                <Label Grid.Row="15" Grid.Column="0" Text=" - Grid (grade) de meios impressos e digitais. " FontSize="20" />
            </Grid>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>